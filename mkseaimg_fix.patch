--- a/sea_img/mkseaimg.c
+++ b/sea_img/mkseaimg.c
@@
-#include <sys/mman.h>
-#include <sys/stat.h>
-#include <unistd.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <ctype.h>      /* toupper() */
+#include <endian.h>     /* htole16/32/64 */
@@
-/* Little‑endian store helpers */
+/* Little‑endian store helpers */
+static void le16(void *p, uint16_t v) { *(uint16_t*)p = htole16(v); }
 static void le32(void *p, uint32_t v) { *(uint32_t*)p = htole32(v); }
 static void le64(void *p, uint64_t v) { *(uint64_t*)p = htole64(v); }
@@ write_fat32()
-    le32(buf+0, 0x0FFFFFF8);   /* cluster 0 */
-    le32(buf+4, 0xFFFFFFFF);   /* cluster 1 (root) */
+    le32(buf+0, 0x0FFFFFF8);   /* cluster 0 (media)   */
+    le32(buf+4, 0xFFFFFFFF);   /* cluster 1 (reserved)*/
+    le32(buf+8, 0x0FFFFFFF);   /* cluster 2 (root dir)*/
@@ build GPT header + one entry
-    struct gpt_entry e = { .first_lba = 2048,
-                           .last_lba  = tot_secs-1 };
-    memcpy(e.type_guid, esp_guid,16);
-    e.name[0] = 'E'; e.name[1]='S'; e.name[2]='P';
-
-    h.table_crc = crc32(&e,sizeof e);
-    h.hdr_crc   = 0; /* calc later */
-
-    if (pwrite(fd,&e,sizeof e, h.table_lba*SECTOR_SIZE)!=sizeof e)die("write tbl");
-    h.hdr_crc = crc32(&h,sizeof h);
+    /* Build a full 16 KiB partition‑entry array (128 entries) */
+    uint8_t tbl[128*128] = {0};
+    struct gpt_entry *e = (struct gpt_entry*)tbl;
+    e->first_lba = 2048;
+    e->last_lba  = tot_secs-1;
+    memcpy(e->type_guid, esp_guid, 16);
+    e->name[0]='E'; e->name[1]='S'; e->name[2]='P';
+
+    h.table_crc = crc32(tbl, sizeof tbl);  /* correct CRC */
+    h.hdr_crc   = 0;                       /* zero for now */
+
+    if (pwrite(fd, tbl, sizeof tbl,
+               h.table_lba*SECTOR_SIZE) != sizeof tbl) die("write tbl");
+
+    h.hdr_crc = crc32(&h, h.hdr_sz);       /* header CRC last */
@@
-    if (pwrite(fd,&h,sizeof h, SECTOR_SIZE)!=sizeof h) die("write gpth");
+    if (pwrite(fd,&h,sizeof h, SECTOR_SIZE)!=sizeof h) die("write gpth");
